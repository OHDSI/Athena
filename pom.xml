<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.odysseusinc.athena</groupId>
    <artifactId>athena</artifactId>
    <version>1.16.0</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <properties>
        <!--
          Baseline for the properties/${env} resource directory. The dev profile is
          activeByDefault, but Maven deactivates activeByDefault profiles as soon as any
          -P is given, so `mvn -PskipUi package` left ${env} unresolved: the resource
          directory silently did not exist and the jar shipped with no application.properties.
          Declaring it here means env always has a value; the env profiles still override it.
        -->
        <env>dev</env>
        <java.version>25</java.version>
        <solr.version>8.11.4</solr.version>
        <disruptor.version>3.4.2</disruptor.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <build.number>${BUILD_NUMBER}</build.number>
        <build.id>${BUILD_TIMESTAMP}</build.id>
        <guava.version>33.7.1-jre</guava.version>
        <lombok.version>1.18.46</lombok.version>
        <postgresql.version>42.7.13</postgresql.version>
        <json.version>20260814</json.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
        <!-- 1.17.5 (docker-java 3.2.x) cannot talk to Docker Engine 25+; the API
             negotiation fails with HTTP 400 and every Testcontainers-backed test
             errors out. Keep this on a version that supports current engines. -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <docker.api.version>1.41</docker.api.version>
        <metrics-core.version>4.2.40</metrics-core.version>
        <spring-retry.version>2.0.13</spring-retry.version>
        <!-- Front end. The UI is compiled from source rather than pulled from a registry
             Point athena.ui.dir at a different checkout to build against it instead of 
             the submodule:
                 mvn package -Dathena.ui.dir=/path/to/AthenaUI -->
        <athena.ui.dir>${project.basedir}/ui</athena.ui.dir>
        <frontend-maven-plugin.version>1.15.4</frontend-maven-plugin.version>
        <!-- Flipped by the skipUi profile. Named separately from maven.resources.skip so
             that skipping the UI copy does not also skip the application's own resources. -->
        <maven.resources.skip.ui>false</maven.resources.skip.ui>
        <!-- Pinned for reproducibility. Any current LTS works now that node-sass (which
             needed a matching prebuilt binary) is gone from AthenaUI. -->
        <node.version>v24.20.0</node.version>
    </properties>

    <profiles>
        <profile>
            <id>skipUi</id>
            <properties>
                <skip.npm>true</skip.npm>
                <skip.installnodenpm>true</skip.installnodenpm>
                <maven.resources.skip.ui>true</maven.resources.skip.ui>
            </properties>
        </profile>
        <profile>
            <id>dev</id>
            <properties>
                <env>dev</env>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <env>test</env>
            </properties>
        </profile>
        <profile>
            <id>qa</id>
            <properties>
                <env>qa</env>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <env>prod</env>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <!--
              Boot 4 manages Jetty at 12.x, but solrj 8.11 is compiled against Jetty 9.4
              and calls org.eclipse.jetty.client.api.Request, which Jetty 12 moved to
              org.eclipse.jetty.client.Request. Unpinned, the tree mixes http2-client 9.4
              with jetty-client 12 and every Solr query fails with NoClassDefFoundError.
              Athena serves on Tomcat, so Jetty only ever appears as a solrj transitive.
              This BOM is imported ahead of spring-boot-dependencies so it wins for
              org.eclipse.jetty artifacts only; overriding the ${jetty.version} property
              instead does not work, because Boot uses it to import a jetty-ee11-bom that
              has no 9.4 release. Revisit when Solr moves to 9.x — that is a Lucene
              index-format change and separate work.
            -->
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-bom</artifactId>
                <version>9.4.53.v20231009</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              Hibernate 7 needs antlr4-runtime 4.13.x for its HQL parser, but test-scoped
              solr-core 8.11 drags in 4.5.1-1 at compile scope and wins on nearest
              definition, so every repository bean fails with
              NoClassDefFoundError: org/antlr/v4/runtime/CharStreams.
            -->
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>4.13.2</version>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>7.2.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
          Native Spring Security replacement for pac4j-saml. On Security 7 this resolves
          OpenSAML 5 and OpenSaml5AuthenticationProvider, so the EOL 3.x line pac4j-saml
          depended on is gone rather than merely pinned.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-saml2-service-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!--
          Flyway 10 moved per-database support out of flyway-core into separate modules,
          so without this it refuses to start with "Unsupported Database: PostgreSQL 16.2".
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.hateoas</groupId>
            <artifactId>spring-hateoas</artifactId>
        </dependency>

        <dependency>
            <artifactId>solr-solrj</artifactId>
            <groupId>org.apache.solr</groupId>
            <version>${solr.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lmax</groupId>
            <artifactId>disruptor</artifactId>
            <version>${disruptor.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-support</artifactId>
        </dependency>

        <!--
          Boot 4 splits auto-configuration per module, so MailSenderAutoConfiguration (and
          therefore the JavaMailSender bean) only exists if the mail starter is present.
          Previously this project got the mail auto-configuration from the monolithic
          spring-boot-autoconfigure and supplied the implementation itself via
          com.sun.mail:jakarta.mail (the old javax.mail namespace). The starter now brings
          both the auto-configuration and the jakarta.mail 2.x implementation
          (angus-mail).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-core</artifactId>
            <version>${solr.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          HttpClient 5 uses HttpVersionPolicy from httpcore5-h2 while constructing its
          default TLS configuration. Normally httpclient5 brings this transitively at
          compile scope, but the nearer, test-scoped solr-core dependency also brings
          httpcore5-h2; Maven's nearest-definition rule therefore narrows the resolved
          artifact to test scope and omits it from the executable jar. The tests still
          pass, but the first RestTemplate request fails in production with
          NoClassDefFoundError: org/apache/hc/core5/http2/HttpVersionPolicy.
          Declare the runtime requirement directly so it is packaged in BOOT-INF/lib.
        -->
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5-h2</artifactId>
        </dependency>

        <!--
          Required at runtime, not just in tests. Athena's own code never touches it, and it
          was briefly declared test-only to keep a solr-core transitive out of the
          production jar - but opensaml-core-api, opensaml-profile-api and opensaml-core-impl
          all depend on it at compile scope, and a direct declaration overrides a transitive
          one, so that scope silently removed it from the artifact. Nothing failed until the
          application was actually started: OpenSaml5AuthenticationProvider's constructor
          touches com.codahale.metrics.MetricRegistry, so the SAML filter chain died with
          ClassNotFoundException on the first real boot. The version pin stays (OpenSAML
          asks for 4.2.26); only the scope was wrong.
        -->
        <dependency>
            <groupId>io.dropwizard.metrics</groupId>
            <artifactId>metrics-core</artifactId>
            <version>${metrics-core.version}</version>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Spring Boot dropped junit-vintage-engine from starter-test in 2.4. Most of
          this suite is still JUnit 4, and without the vintage engine those tests are
          silently skipped rather than failing. Required until they are migrated.
        -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>
        <!-- Still used for @Retryable on email sending. Spring Framework 7 has native
             retry (org.springframework.core.retry); migrating to it is a behaviour
             change, so keep this library for now. -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
            <version>${spring-retry.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.6.0</version>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>commons-beanutils</groupId>
            <artifactId>commons-beanutils</artifactId>
            <version>${commons-beanutils.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>commons-dbutils</groupId>
            <artifactId>commons-dbutils</artifactId>
            <version>1.8.1</version>
            <scope>test</scope>
        </dependency>


    </dependencies>

    <build>
        <finalName>athena</finalName>
        <resources>
            <resource>
                <directory>properties/${env}</directory>
                <includes>
                    <include>*.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.0.0</version>
            </plugin>
            <!--
              Backstop for the same hazard: whatever combination of profiles was used, a
              packaged jar must actually contain a UI. Bound after the copy, so it passes on
              a full build and fails loudly on -PskipUi with nothing built yet.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ui-present</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFilesExist>
                                    <files>
                                        <file>${project.basedir}/src/main/resources/public/index.html</file>
                                        <!-- Comes from properties/${env}; absent if env failed
                                             to resolve, which produces a jar that starts with
                                             no datasource, no Solr URL and no token secret. -->
                                        <file>${project.build.outputDirectory}/application.properties</file>
                                    </files>
                                    <message>
Missing a required file (see below). If it is public/index.html, build the UI or
drop -PskipUi; if it is application.properties, ${env} did not resolve to a
directory under properties/.
  mvn package                                   (builds the ui/ submodule)
  mvn package -Dathena.ui.dir=/path/to/AthenaUI (builds another checkout)
If the submodule is empty: git submodule update --init
                                    </message>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              The UI used to arrive as com.odysseusinc.athena:athena-resources, a
              zip of AthenaUI's dist/ published to a private Nexus - the only artifact that
              still required it, and one that made a clean checkout unbuildable without
              credentials. It is now compiled from source: `ui` is a git submodule pinned to
              an exact AthenaUI commit, so the front end that ships in the jar is identified
              by revision rather than by a mutable SNAPSHOT.

              frontend-maven-plugin downloads its own Node, so no Node is required on the
              build host and every build uses the same version. `npm ci` installs strictly
              from AthenaUI's package-lock.json.

              Skip it with -PskipUi when working on the backend alone; whatever was last
              built into src/main/resources/public/ is then reused as-is.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${athena.ui.dir}</workingDirectory>
                    <!-- Deliberately not under target/: this survives `mvn clean`, so the
                         Node download is not repeated on every clean build. It is also
                         outside the submodule, which stays pristine. -->
                    <installDirectory>${project.basedir}/.frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-ui</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <!-- Same destination the unpack used, so WebConfig's
                                 classpath:/public/ resource handler is unchanged. -->
                            <outputDirectory>${project.basedir}/src/main/resources/public</outputDirectory>
                            <overwrite>true</overwrite>
                            <skip>${maven.resources.skip.ui}</skip>
                            <resources>
                                <resource>
                                    <directory>${athena.ui.dir}/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      maven-compiler-plugin 3.14+ runs javac in-process, which breaks
                      Lombok's javac patching and aborts the build with 'Cannot load from
                      object array because "this.hashes" is null'. Forking gives Lombok a
                      clean javac.
                    -->
                    <fork>true</fork>
                    <compilerArgs>
                        <!--
                          JDK 23 removed implicit annotation processing: javac no longer
                          runs processors merely found on the classpath, so Lombok stops
                          generating and every @Getter/@Setter becomes "cannot find
                          symbol". -proc:full restores classpath discovery.
                          Note the alternative, listing lombok under
                          annotationProcessorPaths, makes Lombok 1.18.46 abort the whole
                          compile with 'Cannot load from object array because
                          "this.hashes" is null'.
                        -->
                        <arg>-proc:full</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!--
                  Version deliberately NOT pinned: it was held at 2.19.1, which predates
                  the JUnit 5 provider, so every org.junit.jupiter test was silently
                  skipped. Inheriting the Spring Boot parent's version fixes
                  that. junit-vintage-engine is declared as a test dependency so the
                  existing JUnit 4 tests keep running alongside them.
                -->
                <configuration>
                    <systemPropertyVariables>
                        <!--
                          docker-java asks for Docker API 1.32, below the 1.40 floor of
                          Docker Engine 25+, and answers HTTP 400 — which Testcontainers
                          reports as "Could not find a valid Docker environment", making
                          the whole suite unrunnable. docker-java reads this only as a
                          system property, never from DOCKER_API_VERSION in the
                          environment. 1.41 is supported by Engine 20.10 through current.
                          Override with -Ddocker.api.version=... if needed.
                        -->
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>3.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>2.17</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>sibboleth</id>
            <name>shibboleth</name>
            <url>https://build.shibboleth.net/nexus/content/repositories/releases/</url>
        </repository>
    </repositories>

</project>
